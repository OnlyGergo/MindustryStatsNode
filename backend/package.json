    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/router-core": "^1.171.32",
    "@types/bun": "^1.4.2",
    "arctic": "^3.7.0",
    "bytebuffer": "^5.0.1",
    "dotenv": "^18.0.4",
    "elysia": "^1.4.10",
    "ip3country": "^5.0.0",
    "p-queue": "^9.3.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "seroval": "^1.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
